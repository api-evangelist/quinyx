        {
          "id": "4e0a1ce4-ea66-4740-a879-87adfee0bfe0",
          "name": "Get new access and refresh token",
          "request": {
            "name": "Get new access and refresh token",
            "description": {
              "content": "To get tokens using your login credentials you will need to set 'grantType' to 'password' and send it together with the 'username' and 'password'. To get tokens using refresh token you will need to set 'grantType' to 'refresh_token' and sent it together with the 'refreshToken'.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "oauth",
                "token"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"grantType\": \"<string>\",\n  \"refreshToken\": \"<string>\",\n  \"username\": \"<string>\",\n  \"password\": \"<string>\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [
            {
              "id": "c7eac097-8430-4049-8579-bb4618564cb1",
              "name": "Tokens are successfully created. Copy 'accessToken' and add it to 'Authorization' header in format 'Bearer accessToken'. Access token will expire in 15 minutes so use received 'refreshToken' to generate new tokens",
              "originalRequest": {
                "url": {
                  "path": [
                    "oauth",
                    "token"
                  ],
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "query": [],
                  "variable": []
                },
                "header": [
                  {
                    "key": "Accept",
                    "value": "application/json"
                  }
                ],
                "method": "POST",
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"grantType\": \"password\",\n  \"refreshToken\": \"SomeRandomStringThatRepresentsRefreshToken\",\n  \"username\": \"foo@example.com\",\n  \"password\": \"someRandomPassword\"\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                }
              },
              "status": "OK",
              "code": 200,
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "{\n  \"token\": {\n    \"tokenType\": \"Bearer\",\n    \"accessToken\": \"receivedAccessToken\",\n    \"expiredIn\": 900,\n    \"refreshToken\": \"receivedRefreshToken\"\n  }\n}",
              "cookie": [],
              "_postman_previewlanguage": "json"
            },
